---
import { data, models, ranked, tiers, whole, fmtDate, quantLabel, decisionHref, type Model } from "../lib/data";
import { allTags } from "../lib/posts";
import { hardwareSlug, fitsTier } from "../lib/hardware";

interface Props {
  toc?: { href: string; label: string }[];
  /** Models the page links to; listed with their rank and score. */
  mentioned?: Model[];
  /** The home page shows the full leaderboard in the main column, so the sidebar shows other things. */
  home?: boolean;
}
const { toc = [], mentioned = [], home = false } = Astro.props;
const top = ranked("overall").slice(0, 8);
const tags = (await allTags()).slice(0, 16);
const SHOWN_TIERS = ["gpu-8", "gpu-12", "gpu-16", "gpu-24", "gpu-32", "mac-16", "mac-24", "mac-32", "mac-64", "mac-128"];
const hw = tiers.filter((t) => SHOWN_TIERS.includes(t.id)).map((t) => ({ t, best: fitsTier(t)[0] })).filter((x) => x.best);
const decisions = (data.decisions ?? []).filter((r) => r.kind === "decision");
const queue = (data as { local_queue?: string[] }).local_queue ?? [];
const startHere = [
  { href: "/posts/run-a-local-llm-with-ollama/", label: "How to run a local LLM with Ollama" },
  { href: "/posts/q4-vs-q8/", label: "Q4 or Q8: which version should you download?" },
  { href: "/posts/check-your-gpu-memory/", label: "How to check your graphics card or Mac memory" },
  { href: "/best-local-llms/methodology/", label: "How we test" },
];
---
<aside aria-label="Sidebar" data-pagefind-ignore>
  {toc.length > 0 && (
    <nav class="toc-side" aria-label="On this page">
      <h2 class="side-title">On this page</h2>
      {toc.map((t) => <a class="side-link" href={t.href}>{t.label}</a>)}
    </nav>
  )}

  {mentioned.length > 0 && (
    <section>
      <h2 class="side-title">Models in this article</h2>
      {mentioned.map((m) => (
        <a class="side-row" href={`/models/${m.slug}/`}>
          <span class="rk">{m.rank}</span><span class="name">{m.name}</span><span class="sc">{whole(m.overall)}</span>
        </a>
      ))}
    </section>
  )}

  <section>
    <h2 class="side-title">Best model for your computer</h2>
    {hw.map(({ t, best }) => (
      <a class="side-row hw" href={`/hardware/${hardwareSlug(t)}/`}>
        <span class="tier">{t.kind === "gpu" ? `${t.gb} GB GPU` : `${t.gb} GB Mac`}</span>
        <span class="name">{best.model.name} {quantLabel(best.quant) !== "standard" && <span class="q">{quantLabel(best.quant)}</span>}</span>
        <span class="sc">{whole(best.model.overall)}</span>
      </a>
    ))}
    <a class="side-more" href="/posts/check-your-gpu-memory/">Not sure how much memory you have?</a>
  </section>

  {!home && (
    <section>
      <h2 class="side-title">Leaderboard</h2>
      {top.map((m) => (
        <a class="side-row" href={`/models/${m.slug}/`}>
          <span class="rk">{m.rank}</span><span class="name">{m.name}</span><span class="sc">{whole(m.overall)}</span>
        </a>
      ))}
      <a class="side-more" href="/best-local-llms/#leaderboard">All {models.length} models →</a>
    </section>
  )}

  {home && decisions.length > 0 && (
    <section>
      <h2 class="side-title">Decision models · accuracy</h2>
      {decisions.slice(0, 5).map((r, i) => (
        <a class="side-row" href={decisionHref(r) ?? "/best-decision-models/"}>
          <span class="rk">{i + 1}</span>
          <span class="name">{r.name} <span class="q">{r.open_weights ? "open" : "closed"}</span></span>
          <span class="sc">{r.accuracy.toFixed(1)}%</span>
        </a>
      ))}
      <a class="side-more" href="/best-decision-models/">All {decisions.length} decision models →</a>
    </section>
  )}

  {home && queue.length > 0 && (
    <section>
      <h2 class="side-title">Testing next (on a 16 GB Mac)</h2>
      <p class="side-text">{queue.join(" · ")}</p>
    </section>
  )}

  <section>
    <h2 class="side-title">Start here</h2>
    {startHere.map((s) => <a class="side-link" href={s.href}>{s.label}</a>)}
  </section>

  <section>
    <h2 class="side-title">Topics</h2>
    <div class="side-tags">
      {tags.map((t) => <a href={`/topics/${t.slug}/`}>{t.tag}</a>)}
    </div>
    <p class="meta" style="margin: 12px 0 0">Scores updated {fmtDate(data.generated)}</p>
  </section>
</aside>
