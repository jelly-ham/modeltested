---
import { tiers, forTier, score, whole, quantLabel, tierLabel } from "../lib/data";

interface Props { by: string; kind: "gpu" | "mac" }
const { by, kind } = Astro.props;
const picks = tiers.filter((t) => t.kind === kind).map((t) => ({ tier: t, list: forTier(t.id, by) }));
---
<div class="tier-cards">
  {picks.map(({ tier, list }) => (
    <div>
      <div class="t">{tierLabel(tier)}</div>
      {list.length ? (
        <>
          <div class="m"><a href={`/models/${list[0].model.slug}/`}>{list[0].model.name}</a></div>
          <div class="sub">Get the {quantLabel(list[0].quant)} version · scored {whole(score(list[0].model, by))}</div>
          {list[1] && <div class="sub" style="margin-top: 4px">Also good: <a href={`/models/${list[1].model.slug}/`} style="color: var(--blue)">{list[1].model.name}</a></div>}
        </>
      ) : <div class="sub" style="margin-top: 6px">Nothing we've tested fits yet.</div>}
    </div>
  ))}
</div>
