---
import { data, ranked, size, minTiers, suiteLabel, quantLabel, whole, tiers } from "../lib/data";

interface Props { by: string }
const { by } = Astro.props;
const rows = ranked(by);
// Only the suites that make up the overall score (decisions has its own page).
const suiteCols = by === "overall" ? data.suites.filter((s) => s.ranked !== false) : data.suites.filter((s) => s.id === by);
const maxGb = (kind: string) => Math.max(...tiers.filter((t) => t.kind === kind).map((t) => t.gb));
const showHard = by === "overall" && rows.some((m) => m.hard != null);
---
<div class="dense-box lb-box">
  <table class="dense lb">
    <thead>
      <tr>
        <th>#</th>
        <th>Model</th>
        {by === "overall" && <th>Score</th>}
        {suiteCols.map((s) => <th>{s.id === "extract" ? "Docs" : suiteLabel(s.id).short}</th>)}
        {showHard && <th title="Our hardest tasks only">Hard</th>}
        <th title="Smallest graphics card that holds it, and the version to download">Min card</th>
        <th title="Smallest Mac that holds it, and the version to download">Min Mac</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((m, i) => {
        const t = minTiers(m);
        const main = by === "overall" ? m.overall : m.suites[by]?.score ?? 0;
        // Only name the version when it's a smaller (quantized) download; "standard" goes in the tooltip.
        const q = (id: string) => { const l = quantLabel(m.memory!.best_quant_by_tier[id]); return l === "standard" ? "" : l; };
        const tip = (id: string) => `Download the ${quantLabel(m.memory!.best_quant_by_tier[id])} version`;
        return (
          <tr>
            <td class="rk">{i + 1}</td>
            <td class="nm"><a href={`/models/${m.slug}/`}>{m.name}</a> <span class="sz">{size(m)}{m.updating && " · updating"}</span></td>
            {by === "overall" && (
              <td class="sc">{whole(main)}</td>
            )}
            <td class="c-break" aria-hidden="true"></td>
            {suiteCols.map((s) => <td class="c-stat" data-label={s.id === "extract" ? "Docs" : suiteLabel(s.id).short}>{whole(m.suites[s.id]?.score)}</td>)}
            {showHard && <td class="c-stat" data-label="Hard">{m.hard == null ? "–" : whole(m.hard)}</td>}
            <td class="st c-runs" data-label="Card" title={t.gpu ? tip(t.gpu.id) : undefined}>{t.gpu ? <>{t.gpu.gb} GB <span class="sz">{q(t.gpu.id)}</span></> : <span class="sz">over {maxGb("gpu")} GB</span>}</td>
            <td class="st c-runs" data-label="Mac" title={t.mac ? tip(t.mac.id) : undefined}>{t.mac ? <>{t.mac.gb} GB <span class="sz">{q(t.mac.id)}</span></> : <span class="sz">over {maxGb("mac")} GB</span>}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<p class="sub lb-note">
  Scores are out of 100. "Min card" and "Min Mac" are the smallest graphics card and Mac that hold the model, with the version to download (none shown means the standard download fits).
  <a href="/best-local-llms/methodology/#memory">How we worked this out</a>
</p>

<style>
  .lb { font-size: 13px; line-height: 1.35; }
  .lb td { padding: 4px 7px; }
  .lb th { padding: 5px 7px; }
  .lb td.nm { min-width: 0; }
  .lb-note { font-size: 13px; margin-top: 8px; }
  .lb-note a { color: var(--blue); }
  .lb .c-break { display: none; }

  /* Phones: two short lines per model instead of a wide table. */
  @media (max-width: 700px) {
    .lb thead { display: none; }
    .lb, .lb tbody { display: block; }
    .lb tr { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1px 12px; padding: 6px 0 6px 1.8em; border-bottom: 1px solid var(--line); }
    .lb td, .lb td:nth-child(n+6) { display: block; padding: 0; border: none; text-align: left; }
    .lb .rk { width: 1.8em; margin-left: -1.8em; margin-right: -12px; flex: none; }
    .lb td.nm { flex: 1; min-width: 0; white-space: normal; }
    .lb .c-stat, .lb .c-runs { font-size: 12.5px; color: var(--text-2); }
    .lb .c-break { display: block; flex-basis: 100%; height: 0; }
    .lb .c-stat::before, .lb .c-runs::before { content: attr(data-label) " "; color: var(--faint); }
  }
</style>
