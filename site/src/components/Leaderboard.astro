---
import Score from "./Score.astro";
import { data, ranked, size, minTiers } from "../lib/data";

interface Props { by: string }
const { by } = Astro.props;
const rows = ranked(by);
const suiteCols = by === "overall" ? data.suites : data.suites.filter((s) => s.id === by);
---
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th class="num">#</th>
        <th>Model</th>
        <th>Size</th>
        {by === "overall" && <th class="num">Overall</th>}
        {suiteCols.map((s) => <th class="num">{s.name}</th>)}
        <th>Smallest GPU</th>
        <th>Smallest Mac</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((m, i) => {
        const t = minTiers(m);
        return (
          <tr>
            <td class="num">{i + 1}</td>
            <td class="model">
              <a href={`/models/${m.slug}/`}>{m.name}</a>
              {m.ollama && <div class="sub"><code>{m.ollama}</code></div>}
            </td>
            <td>{size(m)}</td>
            {by === "overall" && <td class="num"><Score value={m.overall} /></td>}
            {suiteCols.map((s) => <td class="num"><Score value={m.suites[s.id]?.score} /></td>)}
            <td>{t.gpu ? `${t.gpu.gb} GB · ${m.memory!.best_quant_by_tier[t.gpu.id]}` : <span class="sub">&gt; 32 GB</span>}</td>
            <td>{t.mac ? `${t.mac.gb} GB · ${m.memory!.best_quant_by_tier[t.mac.id]}` : <span class="sub">&gt; 64 GB</span>}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<p class="meta">Scores are 0–100. "Smallest GPU/Mac" is the least memory that fits the model at Q4_K_M or better with an {data.memory_assumptions.context.toLocaleString()}-token context, and the best quantization that fits there (<a href="/best-local-llms/methodology/#memory">how we estimate</a>).</p>
