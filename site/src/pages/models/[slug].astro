---
import Article from "../../layouts/Article.astro";
import PostCard from "../../components/PostCard.astro";
import { data, models, tiers, size, whole, suiteLabel, quantLabel, questionTitle, orgName, solvedBy, codingTotal, nCodingTasks, ranked, isLocalRun, quantRunFor, TEST_MAC, type Model } from "../../lib/data";
import { allPosts, verdict, hardwareLine, slugTag, shortDate } from "../../lib/posts";
import publicQs from "../../data/public-questions.json";

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model } = Astro.props as { model: Model };
const posts = await allPosts();
const post = posts.find((p) => p.url === `/models/${model.slug}/`)!;
const outputsFiles = import.meta.glob("../../data/outputs/*.json", { eager: true, import: "default" }) as Record<string, Record<string, Record<string, { output: string; score: number; detail: any }>>>;
const outputs = outputsFiles[`../../data/outputs/${model.slug}.json`] ?? {};

const c = model.suites.coding?.score ?? 0;
const d = model.suites.extract?.score ?? 0;
const nTasks = nCodingTasks();
const docLeader = ranked("extract")[0];
const coder = ranked("coding")[0];
const better = models.find((m) => m.rank === 1 && m.slug !== model.slug);

const mem = model.memory;
const quantRows = mem ? Object.entries(mem.need_gb).map(([q, gb]) => ({ q: quantLabel(q), gb })) : [];
const fitRows = tiers.map((t) => {
  const q = mem?.best_quant_by_tier[t.id];
  return { label: t.kind === "gpu" ? `Graphics card, ${t.gb} GB` : `Mac, ${t.gb} GB`, ok: Boolean(q), ver: q ? quantLabel(q) : "–" };
});
const samples = publicQs.questions.map((q: any) => ({ q, out: outputs[q.suite]?.[q.id] })).filter((s: any) => s.out);
const gap = (s: { public: number | null; private: number | null } | undefined) =>
  s && s.public != null && s.private != null ? s.public - s.private : 0;
const neighbors = posts
  .filter((p) => p.category === "Reviews" && p.url !== post.url)
  .map((p) => ({ p, m: models.find((m) => p.url === `/models/${m.slug}/`)! }))
  .filter(({ m }) => Math.abs(m.rank - model.rank) <= 2)
  .slice(0, 3)
  .map(({ p }) => p);

/** Lead with the model name, the way people search it; stay within ~60 characters. */
function reviewTitle(rawName: string): string {
  const name = rawName.trim();
  const options = [": Our Benchmarks, VRAM and Which Version to Get", ": Benchmarks, VRAM and Which Version to Get", ": Our Benchmarks and VRAM", " Benchmarks and VRAM"];
  return options.map((o) => name + o).find((t) => t.length <= 60) ?? name + " Benchmarks";
}
const qrun = quantRunFor(model);
const qlabel = quantLabel(qrun?.quant) || "Q4";
const toc = [
  { href: "#coding", label: "Coding" },
  { href: "#documents", label: "Reading documents" },
  ...(qrun ? [{ href: "#download", label: `The ${qlabel} download` }] : []),
  ...(mem ? [{ href: "#hardware", label: "Can your computer run it?" }] : []),
  { href: "#try", label: "How to try it" },
  ...(samples.length ? [{ href: "#answers", label: "Its actual answers" }] : []),
];
const jsonLd = [{
  "@context": "https://schema.org", "@type": "Review",
  name: post.title, url: new URL(`/models/${model.slug}/`, Astro.site).href,
  itemReviewed: { "@type": "SoftwareApplication", name: model.name, applicationCategory: "AI model", operatingSystem: "Windows, macOS, Linux",
    ...(model.hf_id ? { sameAs: `https://huggingface.co/${model.hf_id}` } : {}) },
  reviewRating: { "@type": "Rating", ratingValue: Math.round(model.overall), bestRating: 100, worstRating: 0 },
  reviewBody: post.dek,
  author: { "@type": "Organization", name: "Model Tested", url: "https://modeltested.com/" },
  publisher: { "@type": "Organization", name: "Model Tested", url: "https://modeltested.com/" },
  datePublished: post.date, dateModified: data.generated,
}];
---
<Article
  seoTitle={reviewTitle(model.name)}
  description={post.dek}
  heading={post.title}
  dek={post.dek}
  kicker={`Review · updated ${shortDate(data.generated)}`}
  crumbs={[{ href: "/", label: "Home" }, { href: "/topics/reviews/", label: "Reviews" }]}
  cover={post.cover}
  toc={toc}
  jsonLd={jsonLd}
  nav="reviews"
>
  <div class="short">
    <strong>The short version</strong>
    <ul>
      <li>{model.name} is a free model{model.org && ` from ${orgName(model.org)}`} that you can run on your own computer. In our tests it's {verdict(model)}: {whole(model.overall)} out of 100, #{model.rank} of {models.length}.</li>
      <li>It solved {solvedBy(model)} of {codingTotal(model)} coding jobs and scored {whole(d)} on reading documents.{model.hard != null && ` On our hardest tasks it scored ${whole(model.hard)}.`}</li>
      <li>{hardwareLine(model)}</li>
    </ul>
  </div>

  <div class="prose">
    <h2 id="coding">Coding</h2>
    <p>
      Our coding test is {nTasks} programming jobs, from small ones like reading time durations or cleaning up messy data to harder
      ones like a config-file parser or a double-entry ledger. We run each answer against tests the model never sees, and a job only
      counts if everything passes. {model.name} got {solvedBy(model)} of {codingTotal(model)} right.
      {coder.slug === model.slug || coder.suites.coding?.score === c
        ? " That's as good as any model we've tested."
        : ` The best local coders solved ${solvedBy(coder)} of ${codingTotal(coder)}.`}
    </p>

    <h2 id="documents">Reading documents</h2>
    <p>
      The second test hands the model things like an expense claim thread, a pay stub or an insurance statement, and asks for specific
      numbers and dates. Many questions need a bit of math, or noticing a correction further down the email. {model.name} scored {whole(d)}{docLeader.slug === model.slug ? ", the best result we've seen." : `; the best model scored ${whole(docLeader.suites.extract?.score)}.`}
    </p>
  </div>

  <div class="table-box">
    <table>
      <thead><tr><th>Test</th><th class="num">Score</th><th class="num">Public questions</th><th class="num">Secret questions</th></tr></thead>
      <tbody>
        {data.suites.map((s) => {
          const sc = model.suites[s.id];
          return <tr><td>{suiteLabel(s.id).name}</td><td class="num"><b>{whole(sc?.score)}</b></td><td class="num">{whole(sc?.public)}</td><td class="num">{whole(sc?.private)}</td></tr>;
        })}
      </tbody>
    </table>
  </div>
  {model.truncated && model.truncated.of > 0 && model.truncated.n / model.truncated.of >= 0.1 && (
    <div class="note-box">
      {model.truncated.provider_cap ? (<>
      <strong>Its scores are held back by the API.</strong> The provider we test {model.name} through stops every answer at
      {model.truncated.provider_cap.toLocaleString("en-US")} tokens, counting its thinking. On {model.truncated.n} of {model.truncated.of} coding and
      document tasks it was still thinking when it was cut off, so it never gave an answer and those count as wrong. Other models
      get up to 32,768 tokens. Run it yourself with a higher limit and it should do better than its score here.
      </>) : (<>
      <strong>It often thinks too long.</strong> On {model.truncated.n} of {model.truncated.of} coding and document tasks, {model.name} kept
      thinking until it hit our limit (about 25,000 words) and never gave an answer. Those count as wrong, which pulls its score down,
      and through an API you'd still pay for all that thinking.
      On your own computer it means waiting a long time for nothing.
      </>)}
    </div>
  )}
  {model.hard != null && <p class="sub">On the {data.n_hard} hardest tasks (included in the scores above) it scored <b>{whole(model.hard)}</b>. This number separates the top models.</p>}
  {model.updating && <p class="sub">We added new, harder questions. These results are from before; updated scores are on the way.</p>}
  {data.suites.some((s) => gap(model.suites[s.id]) > 15) && (
    <p class="sub">This model did much better on our public questions than on the secret ones. Sometimes that's luck; it can also mean the model has seen the public questions before.</p>
  )}
  {isLocalRun(model)
    ? <p class="sub">We tested the {quantLabel(model.quant)} download, the version most people run, with Ollama on our {TEST_MAC}.</p>
    : !qrun && <p class="sub">We tested the full-size version online. The smaller versions you download usually score a little lower.</p>}

  {qrun && (
    <>
      <div class="prose">
        <h2 id="download">The {qlabel} download</h2>
        <p>
          Most people don't run the full-size model; they download a smaller {qlabel} version. We ran that version with Ollama on our
          {" "}{TEST_MAC} and gave it the same questions.
          {Math.abs(qrun.delta) < 2
            ? ` It scored ${whole(qrun.overall)}, about the same as the full-size model (${whole(qrun.base_overall)}). You lose almost nothing by downloading it.`
            : qrun.delta < 0
              ? ` It scored ${whole(qrun.overall)}, ${whole(-qrun.delta)} points below the full-size model (${whole(qrun.base_overall)}).`
              : ` It scored ${whole(qrun.overall)}, slightly above the full-size model (${whole(qrun.base_overall)}). That's within normal run-to-run variation.`}
        </p>
      </div>
      <div class="table-box">
        <table>
          <thead><tr><th>Test</th><th class="num">Full size (online)</th><th class="num">{qlabel} (our Mac)</th></tr></thead>
          <tbody>
            {data.suites.filter((s) => qrun.suites[s.id]?.score != null && qrun.base_suites[s.id]?.score != null).map((s) => (
              <tr><td>{suiteLabel(s.id).name}</td><td class="num">{whole(qrun.base_suites[s.id]?.score)}</td><td class="num"><b>{whole(qrun.suites[s.id]?.score)}</b></td></tr>
            ))}
            {qrun.hard != null && qrun.base_hard != null && <tr><td>Hardest tasks</td><td class="num">{whole(qrun.base_hard)}</td><td class="num"><b>{whole(qrun.hard)}</b></td></tr>}
            <tr><td><b>Overall</b></td><td class="num">{whole(qrun.base_overall)}</td><td class="num"><b>{whole(qrun.overall)}</b></td></tr>
          </tbody>
        </table>
      </div>
    </>
  )}

  {mem && (
    <>
      <div class="prose">
        <h2 id="hardware">Can your computer run it?</h2>
        <p>
          {quantRows.length > 1
            ? `You can download ${model.name} in several sizes. Smaller versions fit on more computers and lose a little quality, so pick the biggest one that fits.`
            : `${model.name} comes in one standard size, which needs about ${quantRows[0]?.gb} GB of memory.`}
        </p>
      </div>
      <div class="table-box">
        <table>
          <thead><tr><th>Your computer</th><th>Runs it?</th><th>Version to download</th></tr></thead>
          <tbody>
            {fitRows.map((r) => <tr><td>{r.label}</td><td class={r.ok ? "yes" : "no"}>{r.ok ? "Yes" : "No"}</td><td class="mono">{r.ver}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="sub">For normal-length chats. Long documents need more memory. <a href="/posts/q4-vs-q8/" style="color: var(--blue)">Q4 or Q8?</a> · <a href="/best-local-llms/methodology/#memory" style="color: var(--blue)">How we worked this out</a></p>
    </>
  )}

  <div class="prose">
    <h2 id="try">How to try it</h2>
    {model.ollama ? (
      <>
        <p>The easiest way is <a href="/posts/run-a-local-llm-with-ollama/">Ollama</a>. Install it, then run:</p>
        <pre><code>ollama run {model.ollama}</code></pre>
      </>
    ) : (
      <p>Search for "{model.name} GGUF" in LM Studio or on Hugging Face and pick the version that fits your computer. New to this? Start with <a href="/posts/run-a-local-llm-with-ollama/">our Ollama guide</a>.</p>
    )}
    {better && model.rank > 3 && <p>Want the strongest all-rounder instead? <a href={`/models/${better.slug}/`}>{better.name}</a> scored {whole(better.overall)}.</p>}
  </div>

  {samples.length > 0 && (
    <>
      <div class="prose"><h2 id="answers">Its actual answers</h2><p>What {model.name} wrote for our public questions, word for word.</p></div>
      {samples.map(({ q, out }: any) => (
        <details class="answer">
          <summary>
            <span>{suiteLabel(q.suite).short}: {questionTitle(q.id)}</span>
            <span class={out.score === 1 ? "tag-ok" : "tag-no"}>{q.suite === "coding" ? (out.score === 1 ? "Worked" : "Didn't work") : `${Math.round(out.score * 100)}% right`}</span>
          </summary>
          <pre><code>{out.output}</code></pre>
        </details>
      ))}
    </>
  )}
  <p class="sub" style="margin-top: 24px">Size: {size(model)} parameters. First tested {shortDate(model.added ?? data.generated)}.</p>

  <div slot="tags" class="chips">{post.tags.map((t) => <a class="chip" href={`/topics/${slugTag(t)}/`}>{t}</a>)}</div>
  {neighbors.length > 0 && (
    <section slot="after" style="margin-top: 48px">
      <h2 class="section-title" style="margin-bottom: 22px">Models that scored about the same</h2>
      <div class="featured" style="margin-top: 0; padding-top: 0; border-top: none">
        {neighbors.map((p) => <PostCard post={p} heading="h3" />)}
      </div>
    </section>
  )}
</Article>
