---
import Base from "../../layouts/Base.astro";
import Score from "../../components/Score.astro";
import { data, models, tiers, size, pct, fmtDate, type Model } from "../../lib/data";
import publicQs from "../../data/public-questions.json";

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model } = Astro.props as { model: Model };
const outputsFiles = import.meta.glob("../../data/outputs/*.json", { eager: true, import: "default" }) as Record<string, Record<string, Record<string, { output: string; score: number; detail: any }>>>;
const outputs = outputsFiles[`../../data/outputs/${model.slug}.json`] ?? {};

const title = `${model.name} Local Review: Scores, VRAM & Mac Requirements`;
const description = `${model.name} (${size(model)}) ranks #${model.rank} of ${models.length} local models in our tests: ${pct(model.overall)}/100 overall. See how much VRAM each quantization needs and real answers to our public tasks.`;

const mem = model.memory;
const quantRows = mem
  ? Object.entries(mem.need_gb).map(([q, gb]) => ({ q, gb, fits: tiers.filter((t) => t.usable_gb >= gb) }))
  : [];
const neighbors = models.filter((m) => m.slug !== model.slug && Math.abs(m.rank - model.rank) <= 2);
const samples = publicQs.questions.map((q: any) => ({ q, out: outputs[q.suite]?.[q.id] })).filter((s: any) => s.out);
const gap = (s: { public: number | null; private: number | null }) =>
  s.public != null && s.private != null ? s.public - s.private : 0;
---
<Base title={title} description={description}>
  <p class="meta"><a href="/best-local-llms/">Best Local LLMs</a> › {model.name}</p>
  <h1>{model.name}</h1>
  <p class="lede">
    {size(model)} open-weight model{model.org && ` from ${model.org}`}. Ranked <strong>#{model.rank} of {models.length}</strong> in our
    local-model tests with an overall score of <strong>{pct(model.overall)}/100</strong>.
  </p>

  <div class="cards">
    <div class="card"><div class="label">Overall</div><div class="pick">{pct(model.overall)}</div><div class="sub">rank #{model.rank}</div></div>
    {data.suites.map((s) => (
      <div class="card"><div class="label">{s.name}</div><div class="pick">{pct(model.suites[s.id]?.score)}</div><div class="sub">{s.n_public + s.n_private} tasks</div></div>
    ))}
    <div class="card"><div class="label">Size</div><div class="pick">{size(model)}</div><div class="sub">{model.memory ? `Q4_K_M ≈ ${model.memory.need_gb["Q4_K_M"] ?? Object.values(model.memory.need_gb)[0]} GB` : "memory unknown"}</div></div>
  </div>

  <h2>Run it locally</h2>
  {model.ollama ? (
    <pre><code>ollama run {model.ollama}</code></pre>
  ) : (
    <p>No official Ollama tag confirmed yet — look for GGUF builds on Hugging Face.</p>
  )}
  {model.hf_id && <p>Weights: <a href={`https://huggingface.co/${model.hf_id}`} rel="nofollow">huggingface.co/{model.hf_id}</a></p>}

  {mem && (
    <>
      <h2 id="memory">How much memory does {model.name} need?</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Quantization</th><th class="num">Memory needed</th><th>Fits on</th></tr></thead>
          <tbody>
            {quantRows.map((r) => (
              <tr>
                <td>{r.q}</td>
                <td class="num">{r.gb} GB</td>
                <td style="white-space:normal">{r.fits.length ? r.fits.map((t) => t.label).join(", ") : <span class="sub">none of our tiers</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta">Estimate for a {mem.context.toLocaleString()}-token context (KV cache ≈ {mem.kv_cache_gb} GB). Longer contexts need more. <a href="/best-local-llms/methodology/#memory">How we estimate</a>.</p>
    </>
  )}

  <h2>Scores</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Suite</th><th class="num">Score</th><th class="num">Public tasks</th><th class="num">Hidden tasks</th></tr></thead>
      <tbody>
        {data.suites.map((s) => {
          const sc = model.suites[s.id];
          return (
            <tr>
              <td>{s.name}</td>
              <td class="num"><Score value={sc?.score} /></td>
              <td class="num">{pct(sc?.public)}</td>
              <td class="num">{pct(sc?.private)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  {data.suites.some((s) => model.suites[s.id] && gap(model.suites[s.id]) > 15) && (
    <p class="note">This model scores noticeably higher on our public tasks than on the hidden ones. That can be chance on a small sample, but it is also what you'd expect if the public tasks leaked into its training data.</p>
  )}
  <p class="meta">Tested via {model.providers.length ? model.providers.join(", ") : "OpenRouter"} at the provider's full or FP8 precision. A Q4 download will usually score a little lower.</p>

  {neighbors.length > 0 && (
    <>
      <h2>Similar-ranked models</h2>
      <ul>
        {neighbors.map((m) => <li><a href={`/models/${m.slug}/`}>{m.name}</a> — #{m.rank}, {pct(m.overall)}/100, {size(m)}</li>)}
      </ul>
    </>
  )}

  {samples.length > 0 && (
    <>
      <h2 id="answers">Its answers to our public tasks</h2>
      {samples.map(({ q, out }: any) => (
        <details>
          <summary>
            {q.id} <span class={out.score === 1 ? "pill" : "pill fail"}>{q.suite === "coding" ? (out.score === 1 ? "passed" : "failed") : `${Math.round(out.score * 100)}% fields`}</span>
          </summary>
          <pre><code>{out.output}</code></pre>
        </details>
      ))}
    </>
  )}
  <p class="meta">First tested {model.added ? fmtDate(model.added) : "—"}.</p>
</Base>
