---
import Base from "../../layouts/Base.astro";
import Score from "../../components/Score.astro";
import { data, models, tiers, size, whole, fmtDate, suiteLabel, quantLabel, questionTitle, orgName, type Model } from "../../lib/data";
import publicQs from "../../data/public-questions.json";

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model } = Astro.props as { model: Model };
const outputsFiles = import.meta.glob("../../data/outputs/*.json", { eager: true, import: "default" }) as Record<string, Record<string, Record<string, { output: string; score: number; detail: any }>>>;
const outputs = outputsFiles[`../../data/outputs/${model.slug}.json`] ?? {};

const title = `${model.name} Review: How Good Is It, and Can Your Computer Run It?`;
const description = `${model.name} came #${model.rank} of ${models.length} in our tests of local AI models, scoring ${whole(model.overall)}/100. See how much memory it needs and the answers it actually gave.`;

const mem = model.memory;
const quantNote: Record<string, string> = { Q4: "smallest, most popular", Q8: "biggest, best quality" };
const quantRows = mem
  ? Object.entries(mem.need_gb).map(([q, gb]) => ({ q: quantLabel(q), gb, fits: tiers.filter((t) => t.usable_gb >= gb) }))
  : [];
const smallest = quantRows[0];
const neighbors = models.filter((m) => m.slug !== model.slug && Math.abs(m.rank - model.rank) <= 2);
const samples = publicQs.questions.map((q: any) => ({ q, out: outputs[q.suite]?.[q.id] })).filter((s: any) => s.out);
const gap = (s: { public: number | null; private: number | null }) =>
  s.public != null && s.private != null ? s.public - s.private : 0;
const fitsList = (fits: typeof tiers) => {
  const gpu = fits.filter((t) => t.kind === "gpu");
  const mac = fits.filter((t) => t.kind === "mac");
  const parts = [];
  if (gpu.length) parts.push(`graphics cards with ${gpu[0].gb} GB or more`);
  if (mac.length) parts.push(`Macs with ${mac[0].gb} GB or more`);
  return parts.join(", ");
};
---
<Base title={title} description={description}>
  <p class="meta"><a href="/best-local-llms/">Best Local LLMs</a> › {model.name}</p>
  <h1>{model.name}</h1>
  <p class="lede">
    {model.name} is a free AI model{model.org && ` from ${orgName(model.org)}`} that you can download and run on your own computer.
    In our tests it came <strong>#{model.rank} out of {models.length}</strong>, with a score of <strong>{whole(model.overall)} out of 100</strong>.
  </p>

  <div class="cards">
    <div class="card"><div class="label">Overall score</div><div class="pick">{whole(model.overall)}/100</div><div class="sub">#{model.rank} of {models.length}</div></div>
    {data.suites.map((s) => (
      <div class="card"><div class="label">{suiteLabel(s.id).name}</div><div class="pick">{whole(model.suites[s.id]?.score)}/100</div></div>
    ))}
    {smallest && <div class="card"><div class="label">Memory needed</div><div class="pick">from {smallest.gb} GB</div><div class="sub">for the {smallest.q} version</div></div>}
  </div>

  {mem && (
    <>
      <h2 id="memory">Can my computer run it?</h2>
      {quantRows.length > 1 ? (
        <p>
          You can download {model.name} in a few sizes. Smaller versions fit on more computers and lose a little quality.
          If more than one fits, pick the biggest.
        </p>
      ) : (
        <p>{model.name} comes in one standard size.</p>
      )}
      <div class="table-scroll">
        <table>
          <thead><tr><th>Version</th><th class="num">Memory needed</th><th>Works on</th></tr></thead>
          <tbody>
            {quantRows.map((r) => (
              <tr>
                <td>{r.q}{quantNote[r.q] && <span class="sub"> ({quantNote[r.q]})</span>}</td>
                <td class="num">{r.gb} GB</td>
                <td style="white-space:normal">{r.fits.length ? fitsList(r.fits) : <span class="sub">too big for the computers we list</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta">These numbers are for normal-length chats. Feeding it long documents takes more memory. <a href="/best-local-llms/methodology/#memory">How we worked this out</a></p>
    </>
  )}

  <h2>How to try it</h2>
  {model.ollama ? (
    <>
      <p>The easiest way is <a href="https://ollama.com" rel="nofollow">Ollama</a>. Install it, then run:</p>
      <pre><code>ollama run {model.ollama}</code></pre>
    </>
  ) : (
    <p>Search for "{model.name} GGUF" in <a href="https://lmstudio.ai" rel="nofollow">LM Studio</a> or on Hugging Face and pick the version that fits your computer.</p>
  )}

  <h2>How it did in our tests</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Test</th><th class="num">Score</th><th class="num">Public questions</th><th class="num">Secret questions</th></tr></thead>
      <tbody>
        {data.suites.map((s) => {
          const sc = model.suites[s.id];
          return (
            <tr>
              <td>{suiteLabel(s.id).name}<div class="sub" style="white-space:normal">{suiteLabel(s.id).blurb}</div></td>
              <td class="num"><Score value={sc?.score} /></td>
              <td class="num">{whole(sc?.public)}</td>
              <td class="num">{whole(sc?.private)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  {data.suites.some((s) => model.suites[s.id] && gap(model.suites[s.id]) > 15) && (
    <p class="note">
      This model did much better on our public questions than on the secret ones. Sometimes that's just luck. It can also
      mean the model has seen the public questions before.
    </p>
  )}
  <p class="meta">We tested the full-size version online. The smaller versions you download usually score a little lower.</p>

  {neighbors.length > 0 && (
    <>
      <h2>Models that scored about the same</h2>
      <ul>
        {neighbors.map((m) => <li><a href={`/models/${m.slug}/`}>{m.name}</a>: #{m.rank}, {whole(m.overall)}/100</li>)}
      </ul>
    </>
  )}

  {samples.length > 0 && (
    <>
      <h2 id="answers">Its actual answers</h2>
      <p>Here's what {model.name} wrote for our public questions, word for word.</p>
      {samples.map(({ q, out }: any) => (
        <details>
          <summary>
            {suiteLabel(q.suite).short}: {questionTitle(q.id)}{" "}
            <span class={out.score === 1 ? "pill" : "pill fail"}>
              {q.suite === "coding" ? (out.score === 1 ? "worked" : "didn't work") : `${Math.round(out.score * 100)}% right`}
            </span>
          </summary>
          <pre><code>{out.output}</code></pre>
        </details>
      ))}
    </>
  )}
  <p class="meta">
    First tested {model.added ? fmtDate(model.added) : "recently"}. Size: {size(model)} parameters.
    <a href="/best-local-llms/methodology/">Full technical details</a>
  </p>
</Base>
