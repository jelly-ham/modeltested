---
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { allPosts, guidePosts, slugTag, shortDate } from "../../lib/posts";
import { bySlug, type Model } from "../../lib/data";

export async function getStaticPaths() {
  const entries = await getCollection("posts");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const post = (await guidePosts()).find((p) => p.url === `/posts/${entry.id}/`)!;
const related = (await allPosts())
  .filter((p) => p.url !== post.url && p.category !== "Reviews")
  .slice(0, 5);
// Written posts in date order, for previous/next links.
const written = (await guidePosts()).sort((a, b) => a.date.localeCompare(b.date) || a.url.localeCompare(b.url));
const at = written.findIndex((p) => p.url === post.url);
const prev = written[at - 1], next = written[at + 1];
// Models the post links to, in the order they first appear.
const mentioned = [...new Set([...(entry.body ?? "").matchAll(/\/models\/([a-z0-9-]+)\//g)].map((m) => m[1]))]
  .map(bySlug).filter((m): m is Model => !!m).slice(0, 10);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, label: h.text }));
const jsonLd = [{
  "@context": "https://schema.org", "@type": "Article", headline: post.title, description: post.dek,
  datePublished: post.date, publisher: { "@type": "Organization", name: "Model Tested" },
}];
---
<Article
  seoTitle={`${post.title} | Model Tested`}
  description={post.dek}
  heading={post.title}
  dek={post.dek}
  kicker={`${post.category} · ${shortDate(post.date)}`}
  crumbs={[{ href: "/", label: "Home" }, { href: `/topics/${slugTag(post.category)}/`, label: post.category }]}
  cover={post.cover}
  toc={toc}
  jsonLd={jsonLd}
  nav={post.category === "Guides" ? "guides" : "latest"}
  mentioned={mentioned}
>
  <div class="prose"><Content /></div>
  <div slot="tags" class="chips">{post.tags.map((t) => <a class="chip" href={`/topics/${slugTag(t)}/`}>{t}</a>)}</div>
  <div slot="after">
    {(prev || next) && (
      <nav class="prev-next" aria-label="More posts">
        {prev ? <a href={prev.url}><span class="meta">← Previous</span><span class="t">{prev.title}</span></a> : <span></span>}
        {next ? <a class="nx" href={next.url}><span class="meta">Next →</span><span class="t">{next.title}</span></a> : <span></span>}
      </nav>
    )}
    <section class="keep-reading">
      <h2 class="side-title">Keep reading</h2>
      {related.map((p) => (
        <a class="kr" href={p.url}><span class="meta">{shortDate(p.date)}</span><span class="t">{p.title}</span></a>
      ))}
    </section>
  </div>
</Article>
