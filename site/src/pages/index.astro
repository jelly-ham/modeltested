---
import Base from "../layouts/Base.astro";
import CoverArt from "../components/CoverArt.astro";
import PostCard from "../components/PostCard.astro";
import PostRow from "../components/PostRow.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_NAME, TAGLINE, data, models, ranked, fmtDate } from "../lib/data";
import { allPosts, rankingPosts, shortDate } from "../lib/posts";

const posts = await allPosts();
const [hero, codingPost] = rankingPosts();
const top = ranked("overall")[0];
const featured = [
  codingPost,
  posts.find((p) => p.url === `/models/${top.slug}/`),
  posts.find((p) => p.url === "/best-decision-models/") ?? posts.find((p) => p.category === "Guides"),
].filter(Boolean) as typeof posts;
const shown = new Set([hero.url, ...featured.map((p) => p.url)]);
const latest = posts.filter((p) => !shown.has(p.url)).slice(0, 12);

const title = `${SITE_NAME}: Which AI Model Should You Use?`;
const description = `${TAGLINE} Rankings and reviews based on our own tests of ${models.length} models, updated ${fmtDate(data.generated)}.`;
const jsonLd = [{ "@context": "https://schema.org", "@type": "WebSite", name: SITE_NAME, url: Astro.site?.href, description: TAGLINE }];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="cols cols-top">
      <main>
        <section class="hero hero-compact">
          <div class="text">
            <div class="kicker">{hero.category} · {shortDate(hero.date)}</div>
            <h1><a href={hero.url}>{hero.title}</a></h1>
            <p>{hero.dek}</p>
            <a class="btn btn-blue" href={hero.url}>See the full ranking
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>
          <a class="hero-chart" href={hero.url} tabindex="-1" aria-hidden="true">
            <CoverArt cover={hero.cover} size="compact" />
          </a>
        </section>

        <section class="featured featured-compact" aria-label="Featured">
          {featured.map((p) => <PostCard post={p} />)}
        </section>

        <div class="list-compact">
          <h2 class="section-title">Latest <a href="/posts/">All posts →</a></h2>
          {latest.map((p) => <PostRow post={p} />)}
        </div>
        <a class="btn btn-line" href="/posts/" style="margin-top: 20px">See all {posts.length} posts</a>
      </main>
      <Sidebar />
    </div>
  </div>
</Base>
