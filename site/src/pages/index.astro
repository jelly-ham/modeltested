---
import Base from "../layouts/Base.astro";
import { SITE_NAME, TAGLINE, data, models, ranked, fmtDate, whole } from "../lib/data";

const title = `${SITE_NAME}: Which AI Model Should You Use?`;
const description = `${TAGLINE} Rankings based on our own tests, updated whenever a new model comes out. Updated ${fmtDate(data.generated)}.`;

const topOverall = ranked("overall")[0];
const topCoding = ranked("coding")[0];
const sections = [
  {
    href: "/best-local-llms/",
    name: "Best Local LLMs",
    blurb: "Free AI models you can run on your own computer. Find the best one for your PC or Mac.",
    stat: models.length ? `${models.length} models tested. Top pick: ${topOverall.name}` : "First results coming soon",
  },
  {
    href: "/best-local-llms/coding/",
    name: "Best Local LLM for Coding",
    blurb: "Which local model writes code that actually works. We ran every answer to find out.",
    stat: models.length ? `Top pick: ${topCoding.name}` : "First results coming soon",
  },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: SITE_NAME, url: Astro.site?.href, description: TAGLINE },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <h1>{TAGLINE}</h1>
  <p class="lede">
    New AI models come out every week, and every one of them claims to be great. We give them all the same real jobs,
    check the results and keep the rankings up to date.
  </p>

  <h2>Rankings</h2>
  <div class="cards">
    {sections.map((s) => (
      <a class="card" href={s.href} style="text-decoration:none;color:inherit">
        <div class="pick" style="color:var(--accent)">{s.name} →</div>
        <p style="margin:6px 0">{s.blurb}</p>
        <div class="sub">{s.stat}</div>
      </a>
    ))}
  </div>

  {data.changelog.length > 0 && (
    <>
      <h2>Just tested</h2>
      <ul class="log">
        {data.changelog.slice(0, 8).map((c) => (
          <li><span class="meta">{fmtDate(c.date)}:</span> <a href={`/models/${c.slug}/`}>{c.name}</a> scored {whole(c.overall)} and is #{c.rank} of {c.of} local models.</li>
        ))}
      </ul>
    </>
  )}

  <h2>How we test</h2>
  <p>
    We don't copy scores from the companies that make these models. Every model answers the same questions from us, and we
    grade the answers automatically: code has to run, and numbers have to match. Most questions stay secret so models
    can't learn them ahead of time. A sample is public, along with every answer, so you can see exactly how each model did.
  </p>
  <p><a href="/best-local-llms/methodology/">Full technical details</a></p>
</Base>
