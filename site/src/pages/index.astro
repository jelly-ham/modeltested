---
import Base from "../layouts/Base.astro";
import { SITE_NAME, TAGLINE, data, models, ranked, fmtDate, pct } from "../lib/data";

const title = `${SITE_NAME} — Real-Task Tests of AI Models`;
const description = `${TAGLINE} Independent rankings built from hidden, task-specific tests, re-run whenever a notable model ships. Updated ${fmtDate(data.generated)}.`;

const topOverall = ranked("overall")[0];
const topCoding = ranked("coding")[0];
const sections = [
  {
    href: "/best-local-llms/",
    name: "Best Local LLMs",
    blurb: "Open-weight models you can run on your own GPU or Mac, with the best pick for every memory size.",
    stat: models.length ? `${models.length} models tested · top: ${topOverall.name}` : "First results coming soon",
  },
  {
    href: "/best-local-llms/coding/",
    name: "Best Local LLM for Coding",
    blurb: "Python tasks graded by hidden unit tests — which local model writes code that actually works.",
    stat: models.length ? `top: ${topCoding.name} (${pct(topCoding.suites.coding?.score)}%)` : "First results coming soon",
  },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: SITE_NAME, url: Astro.site?.href, description: TAGLINE },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <h1>{TAGLINE}</h1>
  <p class="lede">
    {SITE_NAME} tests AI models on the jobs people actually use them for — with hidden test sets, automatic grading and every
    raw answer to our public tasks on display. When a notable model ships, we test it and update the rankings.
  </p>

  <h2>Rankings</h2>
  <div class="cards">
    {sections.map((s) => (
      <a class="card" href={s.href} style="text-decoration:none;color:inherit">
        <div class="pick" style="color:var(--accent)">{s.name} →</div>
        <p style="margin:6px 0">{s.blurb}</p>
        <div class="sub">{s.stat}</div>
      </a>
    ))}
  </div>

  {data.changelog.length > 0 && (
    <>
      <h2>Latest tests</h2>
      <ul class="log">
        {data.changelog.slice(0, 8).map((c) => (
          <li><span class="meta">{fmtDate(c.date)}</span> — <a href={`/models/${c.slug}/`}>{c.name}</a> tested: {pct(c.overall)}/100, #{c.rank} of {c.of} local LLMs.</li>
        ))}
      </ul>
    </>
  )}

  <h2>How we test</h2>
  <ul>
    <li><strong>Real tasks, not trivia.</strong> Each category has its own task set modeled on everyday work.</li>
    <li><strong>Mostly hidden.</strong> About three quarters of tasks are private so models can't be trained on them.</li>
    <li><strong>Checkable.</strong> Public sample tasks, the grading code and every model's raw answers are published.</li>
    <li><strong>Kept fresh.</strong> New models are picked up automatically and rankings are updated the same day.</li>
  </ul>
  <p><a href="/best-local-llms/methodology/">Read the full methodology →</a></p>
</Base>
