---
import Base from "./Base.astro";
import KeyStrip from "../components/KeyStrip.astro";
import Sidebar from "../components/Sidebar.astro";
import Comments from "../components/Comments.astro";
import type { Cover } from "../lib/posts";
import type { Model } from "../lib/data";

interface Props {
  seoTitle: string;
  description: string;
  heading: string;
  dek: string;
  kicker: string;
  crumbs?: { href: string; label: string }[];
  cover?: Cover;
  toc?: { href: string; label: string }[];
  jsonLd?: object[];
  nav?: string;
  mentioned?: Model[];
}
const { seoTitle, description, heading, dek, kicker, crumbs = [], cover, toc = [], jsonLd = [], nav, mentioned = [] } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const share = [
  { label: "Share on X", cls: "x", href: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(heading)}`,
    icon: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" },
  { label: "Share on Reddit", cls: "reddit", href: `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(heading)}`,
    icon: "M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.870-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.880-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.770.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.330 0 2.470-.810 2.953-1.964.057-.137-.037-.290-.184-.305-.863-.087-1.795-.135-2.769-.135Z" },
];
---
<Base title={seoTitle} description={description} jsonLd={jsonLd} nav={nav} ogType="article">
  <div class="wrap">
    <header class="article-head">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((c, i) => <>{i > 0 && " / "}<a href={c.href}>{c.label}</a></>)}
        </nav>
      )}
      <div class="kicker">{kicker}<span data-views hidden></span></div>
      <h1>{heading}</h1>
      <p class="dek">{dek}</p>
    </header>
    {cover && <KeyStrip cover={cover} />}
    <div class={`cols cols-article${toc.length > 1 ? " has-toc" : ""}`}>
      {toc.length > 1 && (
        <nav class="toc-left" aria-label="On this page">
          <div class="side-title">On this page</div>
          {toc.map((t) => <a href={t.href}>{t.label}</a>)}
        </nav>
      )}
      <main>
        <slot />
        <div class="after-article">
          <slot name="tags" />
          <div class="share">{share.map((s) => (
            <a class={s.cls} href={s.href} rel="noopener" target="_blank" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={s.icon} /></svg>
            </a>
          ))}</div>
        </div>
        <slot name="after" />
        <Comments />
      </main>
      <Sidebar toc={toc} mentioned={mentioned} />
    </div>
  </div>
  <script is:inline>
    // Page views (worker/index.js). One count per reader per page per day; shown once a page has more than 100.
    (() => {
      const MIN_VIEWS = 101; // shown only above 100
      const el = document.querySelector("[data-views]");
      if (!el) return;
      const path = location.pathname, key = "mt-viewed:" + path;
      let last = 0;
      try { last = Number(localStorage.getItem(key)) || 0; } catch (e) {}
      const isNew = Date.now() - last > 864e5;
      fetch("/api/views?path=" + encodeURIComponent(path), { method: isNew ? "POST" : "GET" })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (!d) return;
          if (isNew) try { localStorage.setItem(key, String(Date.now())); } catch (e) {}
          if (d.views >= MIN_VIEWS) { el.textContent = " · " + d.views.toLocaleString("en-US") + " views"; el.hidden = false; }
        })
        .catch(() => {});
    })();
  </script>
</Base>
